# ============================================================
# AgentHub 后端环境变量示例
#
# 队伍：咕嘎一辈子队
# 修改者：Adam Zhang
# 修改日期：2026-05-22
#
# 用法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 按场景（本地开发 / 云端部署）填入实际值
#   3. .env 已加入 .gitignore，禁止提交真实凭据
#
# 参考：CC .env.example（Anthropic-compatible 服务商列表）
#       LibreChat .env.example（多环境配置思路）
# ============================================================


# ============================================================
# 一、运行环境
# ============================================================

# 部署模式：development / staging / production
# 影响：日志格式、CORS 严格度、错误堆栈是否暴露给前端
# ENV=development

# 服务监听地址与端口
# HOST=0.0.0.0
# PORT=8000


# ============================================================
# 二、域名与 CORS
# ============================================================

# 前端入口地址（CORS 允许列表会包含它）
# DOMAIN_CLIENT=http://localhost:5173
# 后端对外暴露地址（生产环境填实际域名，影响生成的回调 URL）
# DOMAIN_SERVER=http://localhost:8000

# CORS 允许的来源，多个用英文逗号分隔
# 本地：http://localhost:5173
# 生产：https://agenthub.example.com,https://www.agenthub.example.com
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# 走 nginx / CDN 反向代理时打开，让 FastAPI 正确读 X-Forwarded-For 等头
# TRUST_PROXY=false

# 生产 HTTPS 部署时务必设为 true（Cookie 仅在 https 下传输）
# SECURE_COOKIES=false


# ============================================================
# 三、数据库
# ============================================================

# 本地：mysql+pymysql://root:your_password@localhost:3306/agenthub
# 云端：mysql+pymysql://user:passwd@rds-xxx.region.rds.amazonaws.com:3306/agenthub
# DB_URL=mysql+pymysql://root:your_password@localhost:3306/agenthub

# 连接池配置（本地默认即可，生产建议调大）
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=3600


# ============================================================
# 四、JWT 鉴权
# ============================================================

# 务必改成至少 32 字符的随机串；可用：openssl rand -hex 32
# JWT_SECRET=please_change_to_a_random_string_at_least_32_chars
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440

# 是否允许新用户注册；Demo 演示前可临时关闭
# ALLOW_REGISTRATION=true


# ============================================================
# 五、日志
# ============================================================

# DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# json / text
# 本地：text 阅读友好；生产：json 便于日志采集（ELK / Loki）
# LOG_FORMAT=text

# stdout / file
# 本地：file 写到 logs/app-{date}.log
# 生产：stdout 交给云日志收集
# LOG_OUTPUT=file


# ============================================================
# 六、网络代理
# ============================================================

# 国内本地访问 Claude / OpenAI 时打开
# 云端部署一般无需代理
# PROXY=http://127.0.0.1:7890


# ============================================================
# 七、限流 / 缓存后端
# ============================================================

# memory：单进程内存（MVP 默认）
# redis ：分布式部署时切到 Redis
# RATE_LIMIT_BACKEND=memory

# 切到 redis 时再填
# REDIS_URL=redis://default:password@localhost:6379/0


# ============================================================
# 八、Claude / Anthropic-compatible Adapter
# ------------------------------------------------------------
# 默认走 Anthropic 官方；可改 BASE_URL 切换到国内兼容服务商。
# ============================================================

# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL_ID=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ----- 国内 Anthropic 兼容服务商（任选一组取消注释） -----
#
# GLM (Zhipu)        https://open.bigmodel.cn
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# ANTHROPIC_MODEL_ID=glm-5
#
# Kimi (Moonshot)    https://platform.moonshot.cn
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# ANTHROPIC_MODEL_ID=kimi-k2.5
#
# DeepSeek           https://platform.deepseek.com
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_MODEL_ID=deepseek-chat
#
# MiniMax            https://platform.minimax.io
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# ANTHROPIC_MODEL_ID=MiniMax-M2.5


# ============================================================
# 九、Codex Adapter
# ============================================================

# Codex CLI 命令名或绝对路径（已加入 PATH 时填 codex 即可）
# CODEX_BIN_PATH=codex


# ============================================================
# 十、OpenCode Adapter
# ============================================================

# OpenCode CLI 命令名或绝对路径
# OPENCODE_BIN_PATH=opencode


# ============================================================
# 十一、Custom Adapter / OpenAI 兼容 API
# ============================================================

# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL_ID=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
